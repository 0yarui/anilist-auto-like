{
  "manifest_version": 3,
  "name": "AniList Auto-Like",
  "version": "1.5.4",
  "description": "Automatically likes activity feed posts on AniList (home and profiles) with rate limiting and auto-scroll.",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://graphql.anilist.co/*",
    "https://anilist.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://anilist.co/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AniList Auto-Like",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "anilist-autolike@addon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "homepage_url": "https://github.com/0yarui/anilist-auto-like",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
